# MISHWAR (مشوار) - Environment Variables Template
# Copy this file to .env.development, .env.staging, or .env.production

# General / Environment
# Runtime Mode: demo | staging | pilot | production
APP_MODE=demo
VITE_APP_MODE=demo
# Flutter/mobile builds can pass the same value with --dart-define=MISHWAR_APP_MODE=demo
MISHWAR_APP_MODE=demo

# Capability Gates
USE_MOCK_DATA=true
USE_REAL_DATABASE=false
USE_REAL_AUTH=false
USE_REAL_GPS=false
USE_REAL_MAPS=false
USE_REAL_NOTIFICATIONS=false
USE_REAL_PAYMENT=false
VITE_USE_MOCK_DATA=true
VITE_USE_REAL_DATABASE=false
VITE_USE_REAL_AUTH=false
VITE_USE_REAL_GPS=false
VITE_USE_REAL_MAPS=false
VITE_USE_REAL_NOTIFICATIONS=false
VITE_USE_REAL_PAYMENT=false
VITE_ALLOW_DEMO_OTP=true
VITE_ALLOW_DEMO_ACCOUNTS=true
VITE_ALLOW_LOCAL_PERSISTENCE=true

# Deployment / Server Configuration
PORT=3000
RELEASE_VERSION=""
RELEASE_BUILD_NUMBER=""
RELEASE_COMMIT=""
STAGING_API_URL="https://staging-api.example.invalid"
PRODUCTION_API_URL="https://api.example.invalid"
VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_TOKEN=""
API_TOKEN=""
METRICS_TOKEN=""
ALLOWED_ORIGINS="http://localhost:3000"
# Set when the backend runs behind a load balancer/reverse proxy so rate limits and logs see the
# real client IP: hop count (e.g. "1"), "true", or a comma-separated list of proxy IPs/subnets.
TRUST_PROXY=""

# Firebase Web App Credentials (From Firebase Console > Project Settings)
# These are browser Firebase config values. Keep real production values in your local .env files
# and hosting secrets, not committed source files.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-web-app-id"
# Enable Firebase Console > Authentication > Sign-in method > Phone.
# For local development, add Firebase test phone numbers in the Console and use those values here manually.

# Backend Firebase Admin SDK (Server-Side Only - Private Key)
# Used by the backend to verify Firebase ID tokens and set trusted custom claims.
# Never expose these values in browser/mobile source code.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
# Optional local/server credential path for Firebase Admin ADC.
# Keep the pointed JSON file outside Git and never expose it to browser/mobile clients.
GOOGLE_APPLICATION_CREDENTIALS="C:\\secure\\mishwar\\firebase-service-account.json"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# After configuring these values, bootstrap the first admin with:
# cd backend
# npm run set-admin -- FIREBASE_UID

# Optional only for temporary local Flutter API testing. Prefer passing a token provider
# from firebase_auth in the app code instead of hardcoding tokens in build commands.
MISHWAR_FIREBASE_ID_TOKEN=""

# Google Maps Platform (Directions, Geocoding, Places)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_BROWSER_KEY"
VITE_USE_MOCK_MAPS=true

# Geo services. Keep server-side provider secrets out of Flutter.
# internal/internal_fallback are development-safe fallbacks only; production activation
# requires official provider configuration and restricted API keys where applicable.
MAP_PROVIDER="osm"
GEOCODING_PROVIDER="internal"
ROUTING_PROVIDER="internal_fallback"
MAPS_API_KEY=""
GEOCODING_API_KEY=""
ROUTING_API_KEY=""
OSRM_BASE_URL=""
NOMINATIM_BASE_URL=""
GEO_COUNTRY_BIAS="YE"
GEO_REQUEST_TIMEOUT_MS=3500

# Risk / Safety / Pilot Configuration
VITE_PILOT_MODE=true
VITE_MAX_PILOT_DRIVERS=10
VITE_MAX_PILOT_CUSTOMERS=100
VITE_DEFAULT_CITY="Sana'a"
VITE_DEFAULT_CURRENCY="YER"
VITE_CASH_ONLY=true
PILOT_CITY=""
PILOT_OPERATING_HOURS=""
MAX_ACTIVE_DRIVERS=""
MAX_PILOT_CUSTOMERS=""
MAX_CONCURRENT_RIDES=""

# Feature Flags
DIGITAL_PAYMENTS_ENABLED=false
PAYOUTS_ENABLED=true
RIDE_CREATION_ENABLED=true
SOS_ESCALATION_ENABLED=true
NEW_DISPATCH_ENABLED=true
GEO_PROVIDER_ENABLED=true
VITE_ENABLE_WALLET=false
VITE_ENABLE_CARD=false
VITE_ENABLE_DELIVERY=false
VITE_ENABLE_CORPORATE=false
VITE_ENABLE_SOS=true
VITE_ENABLE_CHAT=true

# Payment Provider Adapter
# Do not commit real secrets. Task 5A provides the production adapter interface only;
# activation requires official provider documentation and credentials.
PAYMENT_PROVIDER=""
PAYMENT_PROVIDER_BASE_URL=""
PAYMENT_PROVIDER_CLIENT_ID=""
PAYMENT_PROVIDER_CLIENT_SECRET=""
PAYMENT_PROVIDER_WEBHOOK_SECRET=""

# Financial operations limits. These are business/operational limits, not legal limits.
MIN_PAYOUT_AMOUNT=1000
MAX_PAYOUT_AMOUNT=500000
DAILY_PAYOUT_LIMIT=1000000
MAX_REFUND_AMOUNT=500000

# Notifications / FCM
# Server-side FCM uses Firebase Admin credentials above. Keep APNs/FCM private keys outside Git.
FCM_TEST_DEVICE_TOKEN=""

# Deployment smoke tests
SMOKE_BASE_URL="http://localhost:4000"
SMOKE_API_TOKEN=""

# Stage 11A Public Links / Support
# Leave empty until real channels exist. Do not use fake public URLs in production.
SUPPORT_URL=""
SUPPORT_EMAIL=""
PRIVACY_POLICY_URL=""
TERMS_URL=""
