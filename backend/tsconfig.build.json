{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "rootDir": "..",
    "outDir": "dist-build",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../packages/shared_types/src/**/*.ts",
    "../packages/shared_utils/src/**/*.ts"
  ]
}
